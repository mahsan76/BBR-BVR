/* Pacing shift for STARTUP phase:
 *   shift=9  → burst = pacing_rate / 512
 *   At 400 Mbps this gives ~98 KB bursts, filling the WiFi-6 A-MPDU
 *   aggregation window (up to 64 × 1500 = 96 KB) in a single TXOP.
 *   Larger bursts during STARTUP means fewer TXOP slots are wasted while
 *   the pacing rate is still ramping toward the bottleneck bandwidth.
 */
#define BBR_FC_PACING_SHIFT_STARTUP   9

/* Pacing shift for all steady-state phases (DRAIN, PROBE_BW, PROBE_RTT):
 *   shift=10 → burst = pacing_rate / 1024  (TCP/BBRv3 default)
 *   At 400–500 Mbps this gives ~49–61 KB, matching the typical WiFi-6
 *   TXOP data budget (600 Mbps × 5.484 ms / 8 ≈ 41 KB) with some slack.
 *   Algorithm 1 MIN_SEGS=4 floor still applies as the hard lower bound.
 */
#define BBR_FC_PACING_SHIFT_STEADY   10


/* =========================================================================
 * CHANGE 2 — Helper function bbr_fc_update_pacing_shift()
 * Location  : paste this function immediately BEFORE bbr_update_gains()
 *             in tcp_bbr-fc.c.
 *
 * bbr_update_gains() starts at approximately line 942 in the upstream
 * tcp_bbr3.c file.  In your tcp_bbr-fc.c it will be at a similar location.
 * Look for:
